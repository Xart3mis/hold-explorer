{
  "name": "hold-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "test": "vitest run",
    "lint": "eslint . && stylelint \"ui/src/**/*.css\" && prettier --check .",
    "typecheck": "tsc --noEmit",
    "bindings": "node tools/bindings.mjs",
    "tokens": "node tools/design/check-tokens.mjs --css > ui/src/design/tokens.css",
    "check:dist": "node tools/check-dist.mjs"
  },
  "dependencies": {
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource-variable/reddit-mono": "^5.3.0",
    "@tanstack/react-query": "^5.104.1",
    "@tauri-apps/api": "~2.12.3",
    "@tauri-apps/plugin-dialog": "~2.8.2",
    "@tauri-apps/plugin-opener": "~2.7.1",
    "i18next": "^26.4.3",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-aria-components": "1.22.1",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "~2.12.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vitest-axe": "^0.1.0"
  },
  "packageManager": "pnpm@11.28.5"
}
